{
  "name": "dsh-log",
  "version": "0.3.1",
  "description": "可复用的日志系统：宿主落盘引擎（0.3.0：默认 1 行可用、存时硬隔离查时授权聚合、五键行、error 永不丢；不兼容 0.2.x）",
  "license": "MIT",
  "author": "王辰浩",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeatherHunter/dsh-log.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "event-list.template.json",
    "INTEGRATION.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "build": "node build.mjs",
    "pretest": "node build.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
